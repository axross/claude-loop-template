{
  "files": [
    "AGENTS.md",
    "README.template.md",
    ".claude/settings.json",
    ".claude/hooks/session-start.sh",
    ".claude/hooks/check.sh",
    ".claude/hooks/format.sh",
    ".github/workflows/merge-checks.yaml"
  ],
  "tokens": [
    { "name": "PROJECT_NAME", "optional": false, "example": "acme-web" },
    { "name": "PROJECT_OVERVIEW", "optional": false, "example": "Internal dashboard for fleet operations." },
    { "name": "INSTALL_CMD", "optional": false, "example": "npm ci" },
    { "name": "LINT_CMD", "optional": false, "example": "npm run lint" },
    { "name": "UNIT_TEST_CMD", "optional": true, "example": "npm run test:unit" },
    { "name": "PACKAGE_MANAGER", "optional": true, "example": "npm" },
    { "name": "CODE_FILE_REGEX", "optional": true, "example": "\\.(ts|tsx|css)$" },
    { "name": "CODE_FILE_GLOB", "optional": true, "example": "*.ts | *.tsx | *.css" },
    { "name": "FORMAT_FILE_CMD", "optional": true, "example": "npm run format:file --" },
    { "name": "LINT_FIX_FILE_GLOB", "optional": true, "example": "*.ts | *.tsx" },
    { "name": "LINT_FIX_CMD", "optional": true, "example": "npm run lint:fix --" }
  ]
}
